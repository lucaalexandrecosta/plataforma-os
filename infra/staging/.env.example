# Copie para infra/staging/.env (fora do Git) e preencha. Passo a passo no README.

# Endereço público, sem https:// e sem barra no fim. É o domínio fixo do ngrok,
# do túnel da Cloudflare ou o seu domínio (ex.: DuckDNS) no servidor na nuvem.
PUBLIC_HOST=exemplo-fixo.ngrok-free.app

# Atrás de túnel (ngrok/Cloudflare): deixe ":80". Num servidor com IP público
# e domínio apontando para ele: o próprio domínio (o Caddy pega o HTTPS), e
# HTTP_PORT=80 / HTTPS_PORT=443.
SITE_ADDRESS=:80
HTTP_PORT=8088
HTTPS_PORT=8443

# Senhas: só letras, números, - e _. Invente senhas longas; não use estas.
POSTGRES_PASSWORD=troque-esta-senha-do-postgres
APP_DB_PASSWORD=troque-esta-senha-do-app
S3_SECRET_KEY=troque-esta-chave-dos-arquivos
# Caixa de e-mail de teste (https://PUBLIC_HOST/mail): usuário "teste".
MAILPIT_PASSWORD=troque-esta-senha-do-mailpit

# Empresa inicial e o administrador dela (cria a senha no primeiro acesso,
# com o código que chega no e-mail; por padrão, na caixa de teste acima).
EMPRESA_SLUG=minha-empresa
EMPRESA_NOME=Minha Empresa Ltda
EMPRESA_CNPJ=
ADMIN_EMAIL=voce@exemplo.com.br
ADMIN_NOME=Seu Nome

# "sim" carrega também as empresas fictícias do ambiente local (frio-sul e
# forno-norte, com bens, clientes e o técnico eduardo.tecnico@frio-sul.test).
CARREGAR_DEMO=nao

# Túnel (escolha um; ver README).
NGROK_AUTHTOKEN=
CLOUDFLARE_TUNNEL_TOKEN=

# E-mail de verdade (opcional). Sem isto, tudo vai para a caixa de teste.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_ALLOW_INSECURE=false
# EMAIL_FROM=nao-responda@seudominio.com.br
